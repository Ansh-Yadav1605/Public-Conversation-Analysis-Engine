# =============================================================================
# .env.example
# Public Conversation Analysis Engine — API Credentials Template
#
# Copy this file to .env and fill in your credentials.
# The .env file is in .gitignore and will NOT be committed.
# =============================================================================

# --- Reddit API (Phase 2 — connector_reddit.py) ---
# Create an app at: https://www.reddit.com/prefs/apps
# Choose "script" type.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=engine:v0.1 (by /u/your_reddit_username)

# --- Twitter / X API (Phase 2 — connector_social.py) ---
# Create a project + app at: https://developer.twitter.com/en/portal/dashboard
# Requires Free tier or above. Copy the Bearer Token.
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# --- YouTube Data API v3 (Phase 2 — connector_youtube.py) ---
# Enable the API at: https://console.cloud.google.com/apis/library
# Create an API key credential (no OAuth needed for public data).
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Deployment (Railway) ---
# ENGINE_DATA_DIR: mount path of the Railway Volume that persists pipeline data.
# Set this in the Railway dashboard → Variables tab, not in a committed .env file.
# Default (local): not set — pipeline writes to engine/data/ relative to project root.
ENGINE_DATA_DIR=/app/engine/data

# PYTHONPATH: ensures `from engine.xxx import ...` works on Railway.
# Must be /app (the working directory Railway uses for the deployed container).
PYTHONPATH=/app
